// NextWave Wellness — scheduling engine schema.
// Models follow calendarScheduling.md §2 exactly; only indexes have been added
// (they change no field, and the availability queries are unusable without them).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StaffRole {
  CHIROPRACTOR
  NURSE_PRACTITIONER
  REGISTERED_NURSE
  /// Non-clinical. No service currently requires a front desk person, so
  /// their shifts produce no appointment slots — they are rostered here to
  /// keep one record of who works when, and so staff logins (spec §7.5) have
  /// someone to attach to when they arrive.
  FRONT_DESK
}

enum BookingStatus {
  HOLD
  PENDING_REVIEW
  CONFIRMED
  DECLINED
  CANCELLED
}

/// SOAP is the standard structure for chiropractic and clinical visit notes,
/// and maps cleanly onto FHIR Composition sections if this is ever exported to
/// an EHR. GENERAL is the catch-all for anything that is not a SOAP section.
enum NoteKind {
  SUBJECTIVE
  OBJECTIVE
  ASSESSMENT
  PLAN
  GENERAL
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String
  phone     String
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@index([email])
}

model Staff {
  id         String          @id @default(uuid())
  name       String
  role       StaffRole
  /// Soft delete. A departed provider must keep their historical bookings and
  /// authored clinical notes, so rows are deactivated, never removed.
  /// Inactive staff are excluded from availability.
  active     Boolean         @default(true)
  schedules  StaffSchedule[]
  bookings   Booking[]
  visitNotes VisitNote[]
  services   ServiceStaff[]
  account    Account?

  @@index([role])
}

model StaffSchedule {
  id        String @id @default(uuid())
  staffId   String
  dayOfWeek Int // 1 (Monday) to 7 (Sunday)
  startTime String // "08:00"
  endTime   String // "17:00"
  staff     Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek])
}

model Resource {
  id          String        @id @default(uuid())
  name        String // e.g., "IV Chair 1", "Hyperbaric Chamber"
  type        String // "IV_CHAIR", "CHAMBER", "RED_LIGHT_BED", "CONSULT_ROOM"
  maxCapacity Int           @default(1)
  /// Soft delete — a decommissioned room keeps its past bookings.
  /// Inactive resources are excluded from availability.
  active      Boolean       @default(true)
  bookings    Booking[]
  services    ServiceRoom[]

  @@index([type])
}

/// Who may perform a service.
///
/// Replaces `Service.requiredRole`, which tied a service to a whole role — so
/// a front desk person qualified to give shots could not be authorised without
/// making her a nurse. Membership is explicit and never inherited: a new hire
/// performs nothing until someone ticks them, which is deliberate, because
/// this table decides who may carry out a clinical procedure.
model ServiceStaff {
  serviceId String
  staffId   String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([serviceId, staffId])
  @@index([staffId])
}

/// Which rooms a service may be delivered in.
///
/// Replaces the old `Service.resourceType` string, which allowed exactly one
/// room type per service — so Vitamin Shots queued for the single Shot Room
/// while four IV chairs sat idle. A service is bookable in ANY of its listed
/// rooms; the engine takes whichever is free.
///
/// Rooms are shared: several services can list the same room and they contend
/// for it normally, since occupancy is counted per room across all services.
model ServiceRoom {
  serviceId  String
  resourceId String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
  @@index([resourceId])
}

model Service {
  id          String @id @default(uuid())
  /// Matches the marketing site's page filename (minus .html), same
  /// convention as the `?interest=<slug>` links on the contact form. Lets a
  /// "Book now" button deep-link to this exact service without knowing its
  /// UUID. NOT unique across the two hyperbaric rows (60/90 min) — both use
  /// the same page, so both carry `hyperbaric-oxygen-therapy` and the client
  /// disambiguates by duration.
  slug        String
  category    String // "Chiropractic", "Functional Medicine", "Longevity"
  name        String
  durationMin Int
  bufferMin   Int

  /// What the provider writes up after a visit: a full SOAP note, or a short
  /// session log (time, duration, provider, notes). Per service and editable by an
  /// admin. Defaults to SESSION_LOG so a newly added service is never silently
  /// treated as a full clinical encounter — it is opted INTO SOAP.
  documentationType DocumentationType @default(SESSION_LOG)

  /// Wellness Credits this service costs a member at check-out. NULL = not credit-eligible
  /// (a member pays cash). Editable by an admin next to the price.
  creditCost Int?

  /// Swatch key into SERVICE_COLOR_PALETTE (src/lib/serviceColors.ts), not a
  /// hex value — the palette is a fixed library grouped by discipline, and a
  /// service may only be assigned a swatch from its own category's family.
  /// Lets the front desk dashboard color-code booking blocks by service.
  color String

  /// Headline price in cents. Null where the service has no single price —
  /// either it varies by prescription (peptide therapy) or by chosen option
  /// (vitamin shots, biomarker panels — see ServiceOption).
  priceCents Int?
  /// Qualifier shown beside the price, taken verbatim from the service page
  /// ("Walk-in rate", "Pricing varies by prescription").
  priceNote  String?

  /// Service a FIRST-TIME patient should book instead. Manual adjustment
  /// requires a completed spinal & postural exam, so a new patient choosing
  /// it is redirected rather than left for the front desk to correct.
  newPatientSlug String?

  bookings         Booking[]
  options          ServiceOption[]
  rooms            ServiceRoom[]
  staff            ServiceStaff[]
  planPerkServices PlanPerkService[]

  @@index([slug])
  @@index([category])
}

model Booking {
  id            String        @id @default(uuid())
  userId        String
  serviceId     String
  resourceId    String
  staffId       String?
  subOption     String? // Selected panel, peptide, or vitamin shot
  /// Written by the PATIENT at booking time ("recovering from knee surgery").
  /// Context for the provider — deliberately NOT a clinical note. Clinical
  /// content belongs in VisitNote, which is attributed and amend-only.
  patientNote   String?
  startTime     DateTime
  endTime       DateTime
  holdExpiresAt DateTime? // Set to now() + 10 mins when status = HOLD
  status        BookingStatus @default(HOLD)
  isRecurring   Boolean       @default(false)
  createdAt     DateTime      @default(now())

  /// How the appointment came to exist. Existing code never sets this, so every
  /// pre-Phase-2 and every online booking is ONLINE by default.
  source             BookingSource @default(ONLINE)
  /// The staff login that created it, when staff did (phone / walk-in). Null for
  /// the anonymous widget.
  createdByAccountId String?
  /// The canonical patient record. Set only by Phase 2+ code: the anonymous widget
  /// knows nothing of patients, so a booking is LINKED by the front desk afterwards.
  patientId          String?

  /// Consent to appointment texts given by the person who made THIS booking, on the public
  /// widget's checkbox (unchecked by default). `smsConsentLabel` is the exact wording that was
  /// on screen when they ticked it. Set only by the dedicated consent endpoint — the booking
  /// route itself is untouched. Staff-recorded consent lives on Patient and keeps working.
  smsConsentAt       DateTime?
  smsConsentLabel    String?
  /// Set when the patient replied C to the confirmation text.
  patientConfirmedAt DateTime?

  user       User         @relation(fields: [userId], references: [id])
  service    Service      @relation(fields: [serviceId], references: [id])
  resource   Resource     @relation(fields: [resourceId], references: [id])
  staff      Staff?       @relation(fields: [staffId], references: [id])
  visitNotes VisitNote[]
  encounter  Encounter?
  patient    Patient?     @relation(fields: [patientId], references: [id])
  messages   MessageLog[]

  // The availability engine scans by resource/time and by staff/time; the
  // front desk queue scans by status.
  @@index([resourceId, startTime, endTime])
  @@index([staffId, startTime, endTime])
  @@index([status, startTime])
  @@index([startTime])
  @@index([patientId])
}

/// A specific variant of a service that a patient picks on the service page —
/// a vitamin shot, or a biomarker panel. Each has its own price, which is why
/// this is a table rather than a string on Booking.
///
/// It also makes `Booking.subOption` verifiable: before this existed, the
/// booking API accepted whatever `?option=` string arrived from the URL. Now a
/// submitted option must match a real row for that service.
model ServiceOption {
  id         String @id @default(uuid())
  serviceId  String
  label      String // "Vitamin B12", "Galleri Cancer Test"
  priceCents Int
  /// Display order on the service page; lowest first.
  sortOrder  Int    @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, label])
  @@index([serviceId])
}

/// A clinical note a provider wrote about a visit. This is a MEDICAL RECORD,
/// not appointment metadata, and it is modelled accordingly:
///
///   * `authorId` is REQUIRED. An unattributed clinical note is not a valid
///     record, and authorship cannot be reconstructed after the fact.
///   * Notes are NEVER updated in place. Correcting one creates a new row
///     pointing at the original via `amendsId`; the original text survives
///     verbatim. `@unique` on `amendsId` keeps the chain linear — a note can
///     be amended once, and the amendment can itself be amended.
///   * Nothing is deleted. `Booking` uses onDelete: Restrict so a booking
///     carrying clinical notes cannot be removed out from under them.
///
/// The effective (current) text of a note is the tail of its amendment chain:
/// the row that no other row amends.
model VisitNote {
  id        String   @id @default(uuid())
  bookingId String
  authorId  String
  kind      NoteKind @default(GENERAL)
  body      String
  createdAt DateTime @default(now())

  /// Set when this row supersedes an earlier note. Null on an original.
  amendsId    String? @unique
  /// Why this amendment was made — required when amending, for the audit trail.
  amendReason String?

  /// Which login wrote this, taken from the SESSION — never from the request
  /// body. Null only on rows written before accounts existed, when authorship
  /// was merely claimed.
  authorAccountId String?
  /// The provider role the author was acting in, so a person holding admin AND
  /// a provider role leaves an unambiguous record of which hat they wore.
  authorRole      AccountRole?

  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  author    Staff      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  amends    VisitNote? @relation("NoteAmendment", fields: [amendsId], references: [id], onDelete: Restrict)
  amendedBy VisitNote? @relation("NoteAmendment")

  @@index([bookingId, createdAt])
  @@index([authorId])
}

// =============================================================================
// Phase 1 — Foundation: staff accounts, sessions, audit, encounters, integrations
// =============================================================================

enum AccountRole {
  FRONT_DESK     @map("front_desk")
  PROVIDER_CHIRO @map("provider_chiro")
  PROVIDER_NP    @map("provider_np")
  PROVIDER_NURSE @map("provider_nurse")
  ADMIN          @map("admin")
}

/// A staff LOGIN. Deliberately separate from Staff (a bookable provider): a
/// receptionist needs a login but is never bookable, and a provider's bookable
/// identity must outlive a password reset. There are no patient accounts.
model Account {
  id                 String        @id @default(uuid())
  /// Lower-cased on write; the login identifier.
  email              String        @unique
  displayName        String
  /// Argon2id.
  passwordHash       String
  /// Multi-role. Any mix of FRONT_DESK / ADMIN plus AT MOST ONE provider role,
  /// and a provider role requires a matching linked Staff row (enforced in
  /// application code at write time).
  roles              AccountRole[]
  staffId            String?       @unique
  active             Boolean       @default(true)
  mustChangePassword Boolean       @default(true)

  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  /// TOTP. The secret is AES-256-GCM encrypted with MFA_ENCRYPTION_KEY — it must
  /// be recoverable to verify codes, so it cannot be hashed.
  mfaSecretEnc        String?
  mfaPendingSecretEnc String? // set during enrolment, promoted on first valid code
  mfaEnabledAt        DateTime?
  /// Highest TOTP time-step already accepted, so a code cannot be replayed.
  mfaLastStep         Int?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff         Staff?            @relation(fields: [staffId], references: [id])
  sessions      Session[]
  setupTokens   SetupToken[]
  recoveryCodes MfaRecoveryCode[]
}

model Session {
  id             String    @id @default(uuid())
  accountId      String
  /// SHA-256 of the opaque cookie value. The raw token is never stored, so a
  /// database read cannot be replayed as a login.
  tokenHash      String    @unique
  csrfToken      String
  createdAt      DateTime  @default(now())
  /// Slides on USER activity only (see lib/sessions.ts) — background polling must
  /// not keep an unattended screen signed in.
  lastActivityAt DateTime  @default(now())
  /// Absolute cap regardless of activity.
  expiresAt      DateTime
  /// Null until the TOTP step is satisfied (when the account requires MFA).
  mfaVerifiedAt  DateTime?
  revokedAt      DateTime?
  revokedReason  String?
  ipAddress      String?
  userAgent      String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([lastActivityAt])
}

enum SetupTokenPurpose {
  SETUP
  RESET
}

/// One-time link that lets a new (or reset) account choose its own password, so
/// no password is ever created, emailed or logged by an administrator.
model SetupToken {
  id          String            @id @default(uuid())
  accountId   String
  tokenHash   String            @unique
  purpose     SetupTokenPurpose
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime          @default(now())
  createdById String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  accountId String
  /// SHA-256 of the code; shown to the user exactly once.
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  EXPORT
  LOGIN
  LOGIN_FAILED
  LOGOUT
  LOCKOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  MFA_ENROLL
  MFA_VERIFY
  MFA_FAILED
  SESSION_REVOKED
  ACCESS_DENIED
}

/// Append-only. A trigger (see the phase1 migration) rejects UPDATE and DELETE,
/// so the record of who touched what cannot be quietly rewritten. There is
/// deliberately NO foreign key to Account: a departed employee's trail must
/// outlive their login.
///
/// Holds opaque ids and counts only — never a name, number, note, or any PHI
/// value. `meta` is restricted to field NAMES and counts.
model AuditLog {
  id             BigInt      @id @default(autoincrement())
  occurredAt     DateTime    @default(now())
  /// Null = the anonymous public widget, or a system job.
  actorAccountId String?
  actorRoles     String? // comma-joined role names at the time
  action         AuditAction
  resourceType   String
  resourceId     String?
  success        Boolean     @default(true)
  requestId      String?
  ipAddress      String?
  meta           Json?

  @@index([resourceType, resourceId])
  @@index([actorAccountId, occurredAt])
  @@index([occurredAt])
  @@index([requestId])
}

enum EncounterStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  SEEN
  CHECKED_OUT
  NO_SHOW
}

/// The visit itself, separate from Booking so the existing approval lifecycle
/// (HOLD / PENDING_REVIEW / CONFIRMED / …) is untouched. Table only in Phase 1;
/// the front-desk workflow that drives it arrives in Phase 2.
model Encounter {
  id              String          @id @default(uuid())
  bookingId       String          @unique
  status          EncounterStatus @default(SCHEDULED)
  checkedInAt     DateTime?
  checkedInById   String?
  startedAt       DateTime?
  startedById     String?
  seenAt          DateTime?
  checkedOutAt    DateTime?
  checkedOutById  String?
  noShowAt        DateTime?
  scribeConsentAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  /// Soft delete — clinical records are never hard-deleted.
  deletedAt       DateTime?

  booking      Booking       @relation(fields: [bookingId], references: [id])
  revenueEvent RevenueEvent?

  @@index([status, checkedInAt])
}

enum IntegrationKind {
  AI_SCRIBE
  FILE_STORAGE
  MESSAGING
}

/// Which implementation backs each service interface, plus NON-SECRET settings
/// (region, bucket name, model id). Credentials never live here — they come
/// from the environment or an IAM role.
model IntegrationConfig {
  kind        IntegrationKind @id
  provider    String          @default("stub")
  settings    Json            @default("{}")
  enabled     Boolean         @default(true)
  updatedById String?
  updatedAt   DateTime        @updatedAt
}

// =============================================================================
// Phase 2 — Schedule + Front Desk: patients and appointment texts
// =============================================================================

enum BookingSource {
  ONLINE
  PHONE
  WALK_IN
  FRONT_DESK
}

enum DocumentationType {
  SOAP
  SESSION_LOG
}

enum ContactMethod {
  PHONE
  SMS
  EMAIL
}

/// The canonical patient record, managed by the front desk (there is no patient
/// login). Distinct from User, which is a per-booking contact snapshot created by
/// the anonymous widget; a booking is linked to a Patient afterwards.
///
/// Deliberately NOT collected: SSN, insurance (cash practice), payment cards.
model Patient {
  id                String        @id @default(uuid())
  firstName         String
  lastName          String
  preferredName     String?
  dateOfBirth       DateTime?     @db.Date
  sex               String?
  /// As entered, for display.
  phone             String
  /// Digits only — what search and texting actually use.
  phoneDigits       String
  email             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  preferredContact  ContactMethod @default(PHONE)

  /// Consent to receive appointment texts. OFF until someone records it: the
  /// anonymous booking widget cannot capture it, so a text is only ever sent to a
  /// patient whose consent a staff member recorded here.
  smsOptIn               Boolean   @default(false)
  smsOptInAt             DateTime?
  smsConsentRecordedById String?

  /// Non-clinical ("prefers mornings"). Clinical content belongs in a visit note.
  frontDeskNote String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Soft delete — a patient record is never hard-deleted.
  deletedAt     DateTime?

  bookings     Booking[]
  messages     MessageLog[]
  memberships  Membership[]
  creditLedger CreditLedger[]

  @@index([lastName, firstName])
  @@index([phoneDigits])
  @@index([email])
}

enum MessageKind {
  CONFIRMATION
  REMINDER_24H
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/// One row per text we have decided to send (or decided not to). It exists for
/// IDEMPOTENCY — the unique key is what stops a job that runs twice, or on two
/// instances, from texting a patient twice — and for knowing what happened.
///
/// It stores NO phone number and NO message body: the recipient is read from the
/// patient at send time, and the body is rendered from templateId plus three
/// fields (first name, date, time).
///
/// `forStart` is the appointment time the text was FOR. Moving an appointment
/// changes it, which makes the confirmation and reminder due again for the new
/// time instead of being suppressed by the old time's row.
model MessageLog {
  id                String        @id @default(uuid())
  bookingId         String
  patientId         String?
  kind              MessageKind
  forStart          DateTime
  status            MessageStatus @default(QUEUED)
  templateId        String
  attempts          Int           @default(0)
  providerMessageId String?
  /// A code, never a provider error string (those can echo the recipient).
  failureCode       String?
  queuedAt          DateTime      @default(now())
  sentAt            DateTime?
  nextAttemptAt     DateTime?

  booking Booking  @relation(fields: [bookingId], references: [id])
  patient Patient? @relation(fields: [patientId], references: [id])

  @@unique([bookingId, kind, forStart])
  @@index([status, nextAttemptAt])
}

/// A phone number that texted STOP. Checked before EVERY send, whatever else says "consented":
/// consent evidence newer than `suppressedAt` (a fresh checkbox, a staff-recorded consent) overrides
/// it, an older one does not. Keyed by digits only; the number is never logged.
model SmsSuppression {
  phoneDigits  String   @id
  suppressedAt DateTime
  /// 'STOP' (the patient texted it) | 'PROVIDER' (the messaging provider reported an opt-out)
  source       String
}

// =============================================================================
// Phase 3 — memberships, the credit ledger, perks, and revenue events
// =============================================================================

enum MembershipStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum LedgerReason {
  MONTHLY_GRANT
  ADJUSTMENT
  REDEMPTION
  EXPIRATION
}

enum PerkPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PaymentType {
  MEMBER
  CASH
}

enum MemberBenefit {
  CREDITS
  PERK
}

/// A membership tier, as DATA: change a price, a monthly credit count or the rollover from the
/// admin screen without a deploy. (Prevent / Restore / Optimize = 4 / 6 / 8 credits, 90 days.)
model MembershipPlan {
  id              String  @id @default(uuid())
  /// PREVENT | RESTORE | OPTIMIZE — what the contact form and the site refer to.
  code            String  @unique
  name            String
  /// Monthly dues. Collected OUTSIDE this system — nothing here takes payment.
  priceCents      Int
  creditsPerMonth Int
  /// A monthly grant is usable for this many days from the grant date.
  rolloverDays    Int     @default(90)
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  perks       PlanPerk[]
  memberships Membership[]
}

/// An entitlement a tier includes that is COUNTED, not paid for in credits: a monthly vitamin
/// shot or IV, a quarterly body-composition check, guest passes. Pre-filled from the owner's tier
/// copy but INACTIVE until the owner confirms the exact mapping.
model PlanPerk {
  id        String     @id @default(uuid())
  planId    String
  /// monthly_shot_or_iv | quarterly_body_composition | guest_pass | …
  key       String
  label     String
  period    PerkPeriod
  /// How many per period (calendar month / quarter / year, in clinic time).
  quantity  Int
  active    Boolean    @default(false)
  sortOrder Int        @default(0)

  plan     MembershipPlan    @relation(fields: [planId], references: [id])
  services PlanPerkService[]
  usages   PerkUsage[]

  @@unique([planId, key])
}

/// Which services redeem a perk at check-out. A perk with none (guest passes) is used by hand.
model PlanPerkService {
  perkId    String
  serviceId String
  perk      PlanPerk @relation(fields: [perkId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([perkId, serviceId])
}

model Membership {
  id          String           @id @default(uuid())
  patientId   String
  planId      String
  status      MembershipStatus @default(ACTIVE)
  /// Clinic-local dates. Grants fall on this day each month (clamped to a short month's last day).
  startedOn   DateTime         @db.Date
  nextGrantOn DateTime         @db.Date
  pausedAt    DateTime?
  cancelledAt DateTime?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  patient  Patient        @relation(fields: [patientId], references: [id])
  plan     MembershipPlan @relation(fields: [planId], references: [id])
  perkUses PerkUsage[]
  // + in the migration SQL: a partial unique index — one ACTIVE or PAUSED membership per patient.

  @@index([patientId])
  @@index([status, nextGrantOn])
}

/// APPEND-ONLY (database triggers reject UPDATE, DELETE and TRUNCATE). Balance = SUM(delta).
/// A positive row is a LOT (a monthly grant, or a manual add) with its own last-usable day;
/// a negative row (redemption, expiry, manual removal) is spread across lots by CreditAllocation.
/// Corrections are new rows, never edits.
model CreditLedger {
  id             BigInt       @id @default(autoincrement())
  patientId      String
  membershipId   String?
  reason         LedgerReason
  delta          Int
  /// Positive rows only: the last day (clinic-local, inclusive) the credits can be used.
  lotExpiresOn   DateTime?    @db.Date
  /// MONTHLY_GRANT only: the month's grant date. With membershipId and reason it is UNIQUE, so a
  /// job that runs twice, or two at once, cannot grant a month twice.
  periodStart    DateTime?    @db.Date
  encounterId    String?
  revenueEventId String?
  /// The staff login; NULL = a scheduled job.
  actorAccountId String?
  /// A short controlled code, never free text (an adjustment's reason).
  reasonCode     String?
  createdAt      DateTime     @default(now())

  patient     Patient            @relation(fields: [patientId], references: [id])
  allocations CreditAllocation[] @relation("AllocationLedger")
  drawnFrom   CreditAllocation[] @relation("AllocationLot")

  @@unique([membershipId, periodStart, reason])
  @@index([patientId, createdAt])
}

/// APPEND-ONLY. Which lot a negative ledger row drew from (oldest lot first — FIFO), so what is
/// left in each lot is always lot.delta − SUM(allocations), computed without mutating any row.
/// A deferred constraint trigger refuses a commit that would draw a lot below zero.
model CreditAllocation {
  id       BigInt @id @default(autoincrement())
  /// The negative row (the redemption / expiry / removal).
  ledgerId BigInt
  /// The positive row (the lot) it drew from.
  lotId    BigInt
  amount   Int

  ledger CreditLedger @relation("AllocationLedger", fields: [ledgerId], references: [id])
  lot    CreditLedger @relation("AllocationLot", fields: [lotId], references: [id])

  @@index([lotId])
  @@index([ledgerId])
}

/// APPEND-ONLY. One use of a perk. Remaining this period = PlanPerk.quantity − SUM(quantity)
/// for the current periodKey ("2026-11", "2026-Q4", "2026").
model PerkUsage {
  id             BigInt   @id @default(autoincrement())
  membershipId   String
  perkId         String
  patientId      String
  periodKey      String
  quantity       Int      @default(1)
  revenueEventId String?
  actorAccountId String?
  createdAt      DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id])
  perk       PlanPerk   @relation(fields: [perkId], references: [id])

  @@index([membershipId, perkId, periodKey])
}

/// APPEND-ONLY. One row per check-out: what the visit was, what it was worth, and how it was
/// paid — the data Accounting and Reports (Phases 4–5) read, from day one. No payment is
/// processed here: `cashDueCents` is what the desk recorded collecting.
model RevenueEvent {
  id              String         @id @default(uuid())
  encounterId     String         @unique
  bookingId       String
  patientId       String?
  serviceId       String
  /// Snapshots, so a later rename or re-price does not rewrite history.
  serviceName     String
  serviceCategory String
  subOption       String?
  /// What the visit is worth at list price. NULL only when it has none and was paid with credits.
  priceCents      Int?
  /// MEMBER = covered by the membership (credits or a perk); CASH = paid at the desk.
  paymentType     PaymentType
  memberBenefit   MemberBenefit?
  creditsRedeemed Int            @default(0)
  cashDueCents    Int            @default(0)
  /// The member's tier at the time (code), for member events.
  planCode        String?
  occurredAt      DateTime
  recordedById    String
  createdAt       DateTime       @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([occurredAt])
  @@index([serviceId, occurredAt])
  @@index([patientId])
}
