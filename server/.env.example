# Copy to .env and fill in.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

PORT=4000

# IANA zone the clinic physically operates in. All wall-clock times
# (StaffSchedule, clinic hours, dashboard grid) resolve against this.
# Must be an IANA name, not an offset, so DST is handled for you.
CLINIC_TIMEZONE="America/Chicago"

# What this deployment is: demo | beta | live. Drives the patient-facing
# banner. "demo" is the safe default.
BOOKING_MODE=demo

# Lets staff open the real flow while the public sees coming-soon:
#   /?preview=<PREVIEW_KEY>
PREVIEW_KEY=
# Free text shown on the coming-soon page, e.g. "November".
OPENING_WHEN=

# Minutes a HOLD survives before the slot is released.
HOLD_TTL_MINUTES=10

# ── Staff authentication (Phase 1) ──────────────────────────────────────────
# The shared FRONT_DESK_TOKEN is gone: every staff member signs in as themselves.

# 32-byte base64 key that encrypts TOTP authenticator secrets at rest. REQUIRED in
# production (the app refuses to start without it). In development, if unset, a
# throwaway key is generated per process — enrolments won't survive a restart.
# Generate with:  npm run gen-secrets
# Losing or changing this key invalidates every enrolled authenticator.
MFA_ENCRYPTION_KEY=

# Public https:// origin of this app, used to build one-time setup links.
# REQUIRED in production. Defaults to http://localhost:$PORT in development.
APP_BASE_URL=

# Email of the FIRST administrator, read by `npm run seed:admin`. The script
# prints a one-time setup link — no password is ever created or stored.
ADMIN_EMAIL=
# ADMIN_NAME="Administrator"

# Origins allowed to call the PUBLIC (cookie-less) booking API cross-origin.
# CORS_ORIGINS=https://nextwave-wellness.com,https://www.nextwave-wellness.com

# Roles that must use TOTP. Providers are added at the Phase 4 gate:
# MFA_REQUIRED_ROLES=ADMIN,PROVIDER_CHIRO,PROVIDER_NP,PROVIDER_NURSE
# MFA_REQUIRED_ROLES=ADMIN

# The old HTTP Basic "curtain" over the staff pages. RETIRED (off by default);
# kept as a switch for cutover. When on, set DEMO_USER and DEMO_PASSWORD too.
# BASIC_AUTH_GATE=off
# DEMO_USER=
# DEMO_PASSWORD=

# ── Text messaging ──────────────────────────────────────────────────────────
# The clinic's phone number, given in the reply to a patient who texts HELP
# (e.g. "(612) 555-0100"). REQUIRED in production once TWILIO_AUTH_TOKEN is set.
CLINIC_PHONE=
# The messaging provider's auth token. Setting it turns real messaging on AND is the key the
# inbound STOP/HELP webhook's signature is checked against; with NODE_ENV=production and no
# token the webhook refuses everything. Leave unset in development (the webhook then accepts
# unsigned requests so it can be tried by hand; texts go to the local stub).
# TWILIO_AUTH_TOKEN=

# ── Scheduled jobs (appointment texts, monthly credit grant, credit expiry) ──────────────────────────────────────
# Texts are sent by a job. Either run `npm run jobs:run` from cron / a scheduler every
# ~5 minutes (preferred in production), or let a single always-on web instance do it:
# JOBS_IN_PROCESS=true
# JOBS_INTERVAL_MIN=5
# A web service that sleeps when idle sends NO texts while asleep.

# Development only: where the stub provider writes its fake texts and files
# (default ./.devdata, git-ignored). The test run points this at a temp folder.
# DEV_DATA_DIR=

# ── Production database ─────────────────────────────────────────────────────
# With NODE_ENV=production the app REFUSES TO START unless DATABASE_URL requires
# TLS, e.g. ...?schema=public&sslmode=require
