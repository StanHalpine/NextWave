# Copy to .env and fill in.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

PORT=4000

# IANA zone the clinic physically operates in. All wall-clock times
# (StaffSchedule, clinic hours, dashboard grid) resolve against this.
# Must be an IANA name, not an offset, so DST is handled for you.
CLINIC_TIMEZONE="America/Chicago"

# What this deployment is: demo | beta | live. Drives the patient-facing
# banner. "demo" is the safe default.
BOOKING_MODE=demo

# Minutes a HOLD survives before the slot is released.
HOLD_TTL_MINUTES=10

# Shared secret required by front desk endpoints (x-front-desk-token header).
FRONT_DESK_TOKEN="generate-a-long-random-string"
