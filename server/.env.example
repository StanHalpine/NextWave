# Copy to .env and fill in.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

PORT=4000

# IANA zone the clinic physically operates in. All wall-clock times
# (StaffSchedule, clinic hours, dashboard grid) resolve against this.
# Must be an IANA name, not an offset, so DST is handled for you.
CLINIC_TIMEZONE="America/Chicago"

# What this deployment is: demo | beta | live. Drives the patient-facing
# banner. "demo" is the safe default.
BOOKING_MODE=demo

# Lets staff open the real flow while the public sees coming-soon:
#   /?preview=<PREVIEW_KEY>
PREVIEW_KEY=
# Free text shown on the coming-soon page, e.g. "November".
OPENING_WHEN=

# Minutes a HOLD survives before the slot is released.
HOLD_TTL_MINUTES=10

# ── Staff authentication (Phase 1) ──────────────────────────────────────────
# The shared FRONT_DESK_TOKEN is gone: every staff member signs in as themselves.

# 32-byte base64 key that encrypts TOTP authenticator secrets at rest. REQUIRED in
# production (the app refuses to start without it). In development, if unset, a
# throwaway key is generated per process — enrolments won't survive a restart.
# Generate with:  npm run gen-secrets
# Losing or changing this key invalidates every enrolled authenticator.
MFA_ENCRYPTION_KEY=

# Public https:// origin of this app, used to build one-time setup links.
# REQUIRED in production. Defaults to http://localhost:$PORT in development.
APP_BASE_URL=

# Email of the FIRST administrator, read by `npm run seed:admin`. The script
# prints a one-time setup link — no password is ever created or stored.
ADMIN_EMAIL=
# ADMIN_NAME="Administrator"

# Origins allowed to call the PUBLIC (cookie-less) booking API cross-origin.
# CORS_ORIGINS=https://nextwave-wellness.com,https://www.nextwave-wellness.com

# Roles that must use TOTP at sign-in. The default is ADMIN plus all three provider roles (the
# Phase 4 gate), which is what you want. Clinical documentation checks the authenticator itself
# regardless of this setting.
# MFA_REQUIRED_ROLES=ADMIN,PROVIDER_CHIRO,PROVIDER_NP,PROVIDER_NURSE

# The old HTTP Basic "curtain" over the staff pages. RETIRED (off by default);
# kept as a switch for cutover. When on, set DEMO_USER and DEMO_PASSWORD too.
# BASIC_AUTH_GATE=off
# DEMO_USER=
# DEMO_PASSWORD=

# ── Text messaging ──────────────────────────────────────────────────────────
# The clinic's phone number, given in the reply to a patient who texts HELP
# (e.g. "(612) 555-0100"). Defaults to the number published on the website, (308) 830-1951
# (src/clinicContact.ts, kept in step with contact.html by a test); set this only to override it.
CLINIC_PHONE=
# Twilio. Texts are sent through Twilio ONLY when BOTH TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN are set (and NODE_ENV is
# not "test"); otherwise they go to the local stub, which sends nothing. One of the two alone leaves it on the stub and
# logs a warning naming the one that is missing. Set both on the web service AND the cron job (the cron job sends the texts).
#
# The auth token also signs Twilio's webhooks: it is the key both /api/sms/inbound and /api/sms/status are verified against;
# with NODE_ENV=production and no token they refuse everything (503). In development with no token they accept unsigned
# requests so they can be tried by hand.
# TWILIO_AUTH_TOKEN=
# The number texts are sent FROM (E.164). Defaults to the registered toll-free number +18665241007.
# The app refuses to start if this is set to something that is not E.164.
# TWILIO_FROM_NUMBER=+18665241007
# The account SID ("AC" + 32 hex characters) that goes with TWILIO_AUTH_TOKEN. A value of any other shape stops the app
# at start-up. Every text is sent with a StatusCallback of {APP_BASE_URL}/api/sms/status, so APP_BASE_URL must be an https://
# address whose host name has no underscore (Twilio refuses those) — the app checks this at start-up.
# TWILIO_ACCOUNT_SID=

# ── Scheduled jobs (appointment texts, monthly credit grant, credit expiry) ──────────────────────────────────────
# Texts are sent by a job. Either run `npm run jobs:run` from cron / a scheduler every
# ~5 minutes (preferred in production), or let a single always-on web instance do it:
# JOBS_IN_PROCESS=true
# JOBS_INTERVAL_MIN=5
# A web service that sleeps when idle sends NO texts while asleep.

# Development only: where the stub provider writes its fake texts and files
# (default ./.devdata, git-ignored). The test run points this at a temp folder.
# DEV_DATA_DIR=

# ── AI scribe (Phase 4) ─────────────────────────────────────────────────────────────────────
# The scribe sends visit audio and transcripts through FileStorage and AiScribe. Until real adapters
# exist both are local stubs that write to this server's own unencrypted disk, so in production the
# scribe is switched OFF while either is a stub. Set this ONLY on a staging deployment that holds
# nothing but fake patients; never where real patients are seen.
# ALLOW_STUB_INTEGRATIONS=true
# Days after a note is SIGNED that its visit's raw audio is kept before the retention job (inside
# `npm run jobs:run`) deletes it. The transcript and the AI draft are kept. A whole number, 1 to 3650.
# AUDIO_RETENTION_DAYS=30

# ── Production database ─────────────────────────────────────────────────────
# With NODE_ENV=production the app REFUSES TO START unless DATABASE_URL requires
# TLS, e.g. ...?schema=public&sslmode=require
